{
  "name": "postern",
  "version": "0.1.0",
  "private": true,
  "description": "Personal email on Cloudflare's free tier. Receive, store and read your own mail in your own D1 and R2.",
  "license": "PolyForm-Noncommercial-1.0.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "types": "wrangler types",
    "schema": "wrangler d1 execute postern --remote --file=./schema.sql",
    "schema:local": "wrangler d1 execute postern --local --file=./schema.sql",
    "tail": "wrangler tail",
    "vendor": "rm -rf web/vendor/postal-mime && mkdir -p web/vendor/postal-mime && cp -r node_modules/postal-mime/src/. web/vendor/postal-mime/",
    "build": "wrangler deploy --dry-run --outdir=.wrangler/build",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260820.1",
    "typescript": "^5.6.0",
    "postal-mime": "^3.0.0",
    "wrangler": "^4.124.0"
  }
}
