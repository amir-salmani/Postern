{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "postern",
  "account_id": "26b112f83fd08941cf1a78dcb644266c",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "observability": { "enabled": true },

  // The real hostname. Access can only protect a zone you own, not
  // *.workers.dev — and workers_dev is off so this is the only way in.
  "routes": [{ "pattern": "mail.amirsalmani.com", "custom_domain": true }],
  "workers_dev": false,

  // Per-deploy config. Everything here is safe to commit — no secrets.
  "vars": {
    // The domain whose mail this instance owns.
    "MAIL_DOMAIN": "amirsalmani.com",

    // Local-parts that land in the inbox. Everything else caught by the
    // catch-all rule goes to quarantine. Comma-separated, no @.
    "INBOX_ADDRESSES": "hi,amir",

    // NOTE: FORWARD_TO is set as a secret, not here — it is a real mailbox
    // address and this file is public. `wrangler secret put FORWARD_TO`.
    // The safety net forwards every message there regardless of what storage
    // does. Unset disables it — but don't, until you trust this thing.

    // Cloudflare Access. The API fails closed when these are unset, so an
    // unconfigured deploy serves nothing rather than serving the mailbox.
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": ""
  },

  // Served by Cloudflare before the Worker runs, so page loads cost nothing
  // against the 100k/day free invocation budget. Only /api/* is billed.
  "assets": { "directory": "./web" },

  "d1_databases": [
    { "binding": "DB", "database_name": "postern", "database_id": "e32fa224-dac0-4562-b33b-98d6ac8f6dba" }
  ],

  "r2_buckets": [
    { "binding": "RAW", "bucket_name": "postern-raw" }
  ]
}
