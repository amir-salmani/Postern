{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "postern",
  "account_id": "26b112f83fd08941cf1a78dcb644266c",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "observability": { "enabled": true },

  // Every 30 minutes: pull anything Resend holds that we missed, then check
  // whether anything has gone unread for six hours. One cron does both, and
  // it replaces browser polling entirely — 48 invocations a day, not 48 per
  // open tab.
  "triggers": { "crons": ["*/30 * * * *"] },

  // The real hostname. Access can only protect a zone you own, not
  // *.workers.dev — and workers_dev is off so this is the only way in.
  "routes": [{ "pattern": "mail.amirsalmani.com", "custom_domain": true }],
  "workers_dev": false,

  // Per-deploy config. Everything here is safe to commit — no secrets.
  "vars": {
    // The domain whose mail this instance owns.
    "MAIL_DOMAIN": "amirsalmani.com",

    // Local-parts that land in the inbox. Everything else caught by the
    // catch-all rule goes to quarantine. Comma-separated, no @.
    "INBOX_ADDRESSES": "hi,amir",

    // NOTE: FORWARD_TO is set as a secret, not here — it is a real mailbox
    // address and this file is public. `wrangler secret put FORWARD_TO`.
    // The safety net forwards every message there regardless of what storage
    // does. Unset disables it — but don't, until you trust this thing.

    // Cloudflare Access. The API fails closed when these are unset, so an
    // unconfigured deploy serves nothing rather than serving the mailbox.
    // Forward every inbound message to FORWARD_TO so Gmail keeps telling you
    // mail arrived. "all" | "inbox" (skip quarantine) | "off".
    "FORWARD_MODE": "all",

    "ACCESS_TEAM_DOMAIN": "amirsalmani.cloudflareaccess.com",
    "ACCESS_AUD": "cf38f85676b2cd6be36e323c486bb22f0b2c6e416e74f19ad63b1feb2c51bf2c",

    // Outbound identity. RESEND_API_KEY is a secret, not a var.
    "SEND_FROM": "hi@amirsalmani.com",
    "SEND_NAME": "Amir Salmani",

    // Addresses the From picker offers, beyond SEND_FROM. Local-parts only —
    // the domain is always MAIL_DOMAIN, and the server rejects anything not
    // on this list rather than trusting the client's From.
    "SEND_ADDRESSES": "amir,contact,jobs"
  },

  // Served by Cloudflare before the Worker runs, so page loads cost nothing
  // against the 100k/day free invocation budget. Only /api/* is billed.
  "assets": { "directory": "./web" },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "postern",
      "database_id": "e32fa224-dac0-4562-b33b-98d6ac8f6dba",
      // Versioned migrations, tracked by D1 itself. Ad-hoc ALTER TABLE is what
      // let the rules table silently never exist while ingest depended on it.
      "migrations_dir": "migrations"
    }
  ],

  "r2_buckets": [
    { "binding": "RAW", "bucket_name": "postern-raw" }
  ]
}
